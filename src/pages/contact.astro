---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Zephyr Flanigan"
  description="Get in touch with Zephyr Flanigan — open to interesting conversations, new projects, and roles."
  bodyClass="bg-sand min-h-screen flex flex-col"
  canonical="https://zephyrflanigan.com/contact/"
>
  <!-- ===================== SPLIT LAYOUT ===================== -->
  <main class="flex-1 flex flex-col md:flex-row">

    <!-- LEFT / TOP panel — intro -->
    <div class="flex-1 flex items-center justify-center bg-sand p-8 md:p-16 lg:justify-start lg:flex-3 lg:h-screen">
      <div class="flex flex-col justify-center max-w-md w-full">
        <h2 class="leading-tight text-lg font-jetbrains font-normal text-lichen">Say hello</h2>
        <h1 class="text-4xl font-jakarta font-semibold md:text-6xl lg:text-6xl leading-tight mb-4 text-mauve">
          Get in touch
        </h1>
        <h2 class="font-medium text-xl font-jetbrains text-mauve mb-5">I'd love to hear from you</h2>
        <p class="leading-tight font-jetbrains font-normal text-lg mb-8 text-lichen">
          Whether you have a project in mind, a role you think I'd be a good fit for,
          or just want to connect — my inbox is open. I try to respond to everything
          within a couple of days.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/about/" class="btn font-jetbrains text-sand bg-lichen border-lichen rounded-full hover:bg-olive hover:border-olive">About me</a>
          <a href="/portfolio/" class="btn font-jetbrains rounded-full btn-ghost text-lichen hover:bg-olive hover:border-olive hover:text-cream">Portfolio</a>
        </div>
      </div>
    </div>

    <!-- RIGHT / BOTTOM panel — contact methods -->
    <div class="flex-1 flex items-center justify-center bg-lichen p-8 md:p-16 lg:flex-1 lg:h-screen">
      <div class="max-w-md flex flex-col w-full">

        <p class="font-jetbrains text-cream text-sm uppercase tracking-widest mb-6">Reach me at</p>

        <!-- Email display -->
        <div class="mb-2">
          <p class="font-jakarta font-semibold text-sand text-xl mb-1">Email</p>
          <div class="flex items-center gap-3 mb-4">
            <span id="email-text" class="font-jetbrains text-cream text-base">hello@zephyrflanigan.com</span>
            <button id="copy-email" aria-label="Copy email address"
                    class="btn btn-ghost btn-xs text-cream hover:text-sand">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                   viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
            <span id="copy-confirm" class="font-jetbrains text-xs text-cream opacity-0 transition-opacity">Copied!</span>
          </div>
          <a
            href="mailto:hello@zephyrflanigan.com"
            class="btn font-jetbrains text-olive bg-sand border-sand rounded-full hover:bg-driftwood hover:border-driftwood w-full mb-8"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
            </svg>
            Send an email
          </a>
        </div>

        <div class="border-t mb-8" style="border-color: rgba(250, 246, 240, 0.2);"></div>

        <!-- Social links -->
        <p class="font-jakarta font-semibold text-sand text-xl mb-4">Socials</p>
        <div class="flex flex-col gap-3">
          <a
            href="https://linkedin.com/in/zephyrflanigan"
            target="_blank"
            rel="noopener noreferrer"
            class="btn font-jetbrains text-olive bg-sand border-sand rounded-full hover:bg-driftwood hover:border-driftwood"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
            </svg>
            LinkedIn
          </a>
          <a
            href="https://github.com/zephyrflanigan"
            target="_blank"
            rel="noopener noreferrer"
            class="btn font-jetbrains text-olive bg-sand border-sand rounded-full hover:bg-driftwood hover:border-driftwood"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
            </svg>
            GitHub
          </a>
        </div>

      </div>
    </div>

  </main>
  <!-- ==================== END SPLIT LAYOUT ==================== -->

  <script>
    // 3d — copy email to clipboard
    const copyBtn = document.getElementById('copy-email');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = document.getElementById('email-text')?.textContent?.trim() ?? '';
        await navigator.clipboard.writeText(email);
        const confirm = document.getElementById('copy-confirm');
        if (confirm) {
          confirm.classList.replace('opacity-0', 'opacity-100');
          setTimeout(() => confirm.classList.replace('opacity-100', 'opacity-0'), 2000);
        }
      });
    }
  </script>
</Layout>
