---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="About — Zephyr Flanigan"
  description="Learn about Zephyr Flanigan — full stack engineer, background, experience, and what drives the work."
  canonical="https://zephyrflanigan.com/about/"
>
  <!-- ===================== MAIN CONTENT ===================== -->
  <main class="flex-1 pt-28 pb-24 px-8 md:px-16 lg:px-16">
    <div class="max-w-2xl">

      <!-- ---- INTRO ---- -->
      <section class="mb-20 reveal">
        <p class="font-jetbrains text-lichen text-lg mb-3">Full Stack Engineer</p>
        <h1 class="text-4xl md:text-6xl font-jakarta font-semibold text-mauve leading-tight mb-8">
          Zephyr Flanigan
        </h1>
        <p class="font-jetbrains text-clay text-lg leading-relaxed mb-5">
       I'm a software engineer based in New York, working across the full stack, 
       though I naturally gravitate toward front-end development. I enjoy the challenge 
       of solving technical problems, but what keeps me coming back is 
       building something people can actually interact with. There's 
       something satisfying about watching an idea become a real 
       product that someone can see, use, and enjoy.
       <br><br>

      Outside of software, you'll usually find me knitting, 
      arranging music, or in the kitchen baking something new. 
      I love to take things that are not much on their own and 
      turn them into something whole. A ball of yarn turns into a scarf, 
      sugar and flour into a cake, notes on a scale into complex harmonies, 
      and of course, lines of code into enaging and intuitive platforms.
      <br><br>

      No matter the medium, I always have the same goal: to create something 
      that invites users to explore and connect with one another, whether 
      it’s through a screen, a song, or a freshly baked cookie.
        </p>
        <a
          href={`${base}files/resume.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn font-jetbrains text-sand bg-lichen border-lichen rounded-full hover:bg-olive hover:border-olive"
        >
          View resume
        </a>
      </section>

      <div class="border-t mb-20" style="border-color: rgba(184, 144, 140, 0.3);"></div>

     

  
      <!-- ---- CONNECT ---- -->
      <section class="mb-8 reveal">
        <p class="font-jetbrains text-lichen text-sm uppercase tracking-widest mb-4">Let's talk</p>
        <h2 class="text-3xl font-jakarta font-semibold text-mauve leading-tight mb-6">
          Get in touch
        </h2>
        <p class="font-jetbrains text-clay text-lg leading-relaxed mb-8">
          I'm always open to interesting conversations! I'd love to hear about what you're working on
          and how we can connect.
        </p>
        <a href="/contact/" class="btn font-jetbrains text-sand bg-lichen border-lichen rounded-full hover:bg-olive hover:border-olive">Contact me</a>
      </section>

    </div>
  </main>
  <!-- ==================== END MAIN CONTENT ==================== -->

  <!-- 3e — back-to-top button -->
  <button id="back-to-top" aria-label="Back to top"
          class="fixed bottom-8 right-8 btn btn-circle bg-lichen border-lichen text-sand
                 hover:bg-olive hover:border-olive opacity-0 pointer-events-none
                 transition-opacity z-40">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <script>
    const backToTop = document.getElementById('back-to-top');
    if (backToTop) {
      window.addEventListener('scroll', () => {
        const show = window.scrollY > 300;
        backToTop.classList.toggle('opacity-0', !show);
        backToTop.classList.toggle('pointer-events-none', !show);
      }, { passive: true });

      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</Layout>
